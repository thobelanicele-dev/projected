ANTHROPIC_API_KEY=
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=

# Auth database: Supabase Postgres, used as a plain Postgres database only
# (no Supabase Auth/SDK). Get this from the Supabase dashboard:
# Project Settings -> Database -> Connection string -> "Transaction" pooler
# mode (port 6543, not the direct 5432 connection). Replace [YOUR-PASSWORD]
# with your actual database password.
DATABASE_URL=

# Auth: Resend (https://resend.com) for verification/reset emails.
# Leave RESEND_API_KEY blank to develop locally — email links are logged to
# the server console instead of being sent.
RESEND_API_KEY=
# Must be an address on a domain verified in your Resend account, e.g.
# "FxInsites <noreply@yourdomain.com>". Falls back to Resend's shared test
# sender if left blank (fine for local dev, not for real delivery).
EMAIL_FROM=
# Base URL used to build links inside emails.
APP_URL=http://localhost:3000

# Billing: Paystack (https://dashboard.paystack.com) secret key, used to
# initialize checkout, verify transactions, and validate webhook signatures.
# Dashboard -> Settings -> API Keys & Webhooks. Use the test-mode secret key
# while developing. Also set the webhook URL there to
# {APP_URL}/api/billing/webhook.
PAYSTACK_SECRET_KEY=
